# Supabase Backend Configuration
# Paste your Supabase Project credentials below from https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Razorpay Payment Gateway Configuration (Optional)
# If provided, enables live/test SDK checkout from https://dashboard.razorpay.com/app/keys
# If omitted or default, the interactive in-app Demo Razorpay Gateway sandbox is used automatically
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_here
